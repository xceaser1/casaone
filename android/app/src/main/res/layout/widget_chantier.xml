<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_racine"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_fond">

    <TextView android:id="@+id/w_projet"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CASA ONE" android:textColor="#B8C6E8" android:textSize="11sp"
        android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end"/>

    <TextView android:id="@+id/w_avancement"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="—" android:textColor="#FFFFFF" android:textSize="30sp"
        android:textStyle="bold" android:layout_marginTop="2dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="planchers coulés" android:textColor="#8FA6D8" android:textSize="11sp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical">
        <TextView android:id="@+id/w_presents"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="#FFFFFF" android:textSize="15sp"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" sur site" android:textColor="#8FA6D8" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
