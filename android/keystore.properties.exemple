# Cle de signature de production — MODELE.
#
# Copier ce fichier en "keystore.properties" (ignore par git) et le completer.
# Sans ce fichier, le build de release retombe sur la signature de debogage.
#
# Creer la cle (une seule fois, a conserver hors de cette machine) :
#
#   keytool -genkeypair -v -keystore casaone-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias casaone
#
# ATTENTION : perdre cette cle rend toute mise a jour impossible. Les
# utilisateurs devraient desinstaller l'application — et perdraient leurs
# pointages encore en attente d'envoi. Sauvegardez-la ailleurs qu'ici.

storeFile=casaone-release.jks
storePassword=CHANGEZ_MOI
keyAlias=casaone
keyPassword=CHANGEZ_MOI
